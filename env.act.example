# Arquivo de exemplo para variáveis de ambiente do act
# Copie este arquivo para .env.act para testar workflows localmente

# Node.js Configuration
NODE_VERSION=20

# Test Configuration
COVERAGE_THRESHOLD=80
NODE_ENV=test

# Build Configuration
NEXT_TELEMETRY_DISABLED=1

# CI Configuration
CI=true
GITHUB_ACTIONS=true

# Cache Configuration
NPM_CACHE_FOLDER=.npm
YARN_CACHE_FOLDER=.yarn

# Debug Configuration (opcional)
DEBUG=act:*
VERBOSE=true
