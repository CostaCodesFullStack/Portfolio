# GitHub Actions Environment Configuration
# Este arquivo contém as configurações padrão para os workflows

# Node.js Configuration
NODE_VERSION=20
NODE_ENV=production

# Test Configuration
COVERAGE_THRESHOLD=80
TEST_TIMEOUT=30000

# Build Configuration
NEXT_TELEMETRY_DISABLED=1
ANALYZE=false

# Security Configuration
NPM_AUDIT_LEVEL=moderate
CODEQL_TIMEOUT=360

# Deploy Configuration
VERCEL_TIMEOUT=300
DEPLOY_CONFIRMATION=true
