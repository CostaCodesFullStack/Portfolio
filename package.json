{
  "name": "caua-costa-portfolio",
  "version": "1.0.0",
  "description": "Portfólio profissional de Cauã Costa - Estudante de Engenharia de Software",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --watchAll=false --passWithNoTests",
    "test:smoke": "jest --testPathPattern=smoke --passWithNoTests",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run lint && npm run type-check && npm run test:ci",
    "pre-commit": "npm run lint:fix && npm run format && npm run test:ci"
  },
  "dependencies": {
    "@types/nodemailer": "^7.0.2",
    "framer-motion": "^10.16.16",
    "nodemailer": "^7.0.9",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^4.12.0",
    "react-intersection-observer": "^9.5.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "20.10.5",
    "@types/react": "18.2.45",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "10.4.16",
    "eslint": "8.56.0",
    "eslint-config-next": "14.0.4",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "next": "^15.5.4",
    "postcss": "8.4.32",
    "prettier": "^3.1.1",
    "puppeteer": "^24.22.3",
    "tailwindcss": "3.4.0",
    "typescript": "5.3.3"
  },
  "keywords": [
    "portfolio",
    "engenharia-software",
    "desenvolvedor",
    "react",
    "nextjs"
  ],
  "author": "Cauã Costa",
  "license": "MIT"
}
